        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: SFX AudioCategoryIronSoul property is not wired")
        Debug.MessageBox(IronSoulNative.TextGet("MessageBox.ControllerMissingSoundCategory"))
        return False
    endif
    if !Cleanup
