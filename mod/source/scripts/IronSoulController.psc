        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: SFX property is not wired")
        Debug.MessageBox(IronSoulNative.TextGet("MessageBox.ControllerMissingSFX"))
        return False
    endif
    if !SFX.AudioCategoryIronSoul
