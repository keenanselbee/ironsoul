; Wired domain owners.
; LoadConfig() is the wiring gate; lifecycle and update flow may trust these
; required components after it succeeds. Keep defensive guards where events can
; run before full wiring or where the component is intentionally optional.
IronSoulConfig Property Config Auto
IronSoulPersistence Property Persistence Auto
IronSoulIdentity Property Identity Auto
IronSoulJournal Property Journal Auto
IronSoulDeath Property Death Auto
IronSoulLuck Property Luck Auto
IronSoulUI Property Presentation Auto
IronSoulSFX Property SFX Auto
IronSoulCleanup Property Cleanup Auto
IronSoulRespawn Property Respawn Auto
IronSoulDragonSoulRevive Property DragonSoulRevive Auto
IronSoulTiers Property Tiers Auto
IronSoulHeartshards Property Heartshards Auto
IronSoulEffects Property Effects Auto
IronSoulGlobals Property Globals Auto

; Uninstall / disable mode
Bool _modDisabled = False

; Dragon Soul Revive / Respawn
FormList Property BeastList Auto

; --- Wiring & Diagnostics ---
; ============================

Function LogController(Int level, String msg, Bool suppressNotify = False)
    if Config
        Config.LogComponentMsg("Controller", level, msg, suppressNotify)
        return
    endif

    Debug.Trace("[IronSoul] [" + IronSoulConfig.LogLevelTag(level) + "] [Controller] " + msg)
EndFunction

Function LogControllerSnapshot(Int level, String msg)
    if Config
        Config.LogComponentSnapshot("Controller", level, msg)
        return
    endif

    Debug.Trace("[IronSoul] [" + IronSoulConfig.LogLevelTag(level) + "] [Snapshot] " + msg)
EndFunction

Bool Function LoadConfig()
    if !Config
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Config property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulConfig quest component is not wired.")
        return False
    endif
    if !Persistence
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Persistence property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulPersistence quest component is not wired.")
        return False
    endif
    if !Identity
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Identity property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulIdentity quest component is not wired.")
        return False
    endif
    if !Journal
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Journal property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulJournal quest component is not wired.")
        return False
    endif
    if !Death
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Death property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulDeath quest component is not wired.")
        return False
    endif
    if !Luck
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Luck property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulLuck quest component is not wired.")
        return False
    endif
    if !Presentation
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Presentation property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulUI quest component is not wired.")
        return False
    endif
    if !SFX
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: SFX property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulSFX quest component is not wired.")
        return False
    endif
    if !Cleanup
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Cleanup property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulCleanup quest component is not wired.")
        return False
    endif
    if !Respawn
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Respawn property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulRespawn quest component is not wired.")
        return False
    endif
    if !DragonSoulRevive
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: DragonSoulRevive property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulDragonSoulRevive quest component is not wired.")
        return False
    endif
    if !Tiers
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Tiers property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulTiers quest component is not wired.")
        return False
    endif
    if !Heartshards
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Heartshards property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulHeartshards quest component is not wired.")
        return False
    endif
    if !Effects
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Effects property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulEffects quest component is not wired.")
        return False
    endif
    if !Globals
        SetModDisabled(True)
        LogController(IronSoulConfig.LOG_ERR(), "LoadConfig: Globals property is not wired")
        Debug.MessageBox("Iron Soul has been disabled because the IronSoulGlobals quest component is not wired.")
        return False
    endif

    Config.LoadFromIni()
    Game.SetGameSettingFloat("fPlayerDeathReloadTime", 3600.0)
    if Config.IsRequiemCompatibilityEnabled()
        GlobalVariable requiemNoDeathHandling = Game.GetFormFromFile(0x00AA1E9C, "Requiem.esp") as GlobalVariable
        if requiemNoDeathHandling
            requiemNoDeathHandling.SetValueInt(1)
            LogController(IronSoulConfig.LOG_INFO(), "LoadConfig: Requiem death handling disabled")
        else
            LogController(IronSoulConfig.LOG_DBG(), "LoadConfig: Requiem death handling global not found", True)
        endif
    endif
    Respawn.RefreshRuntime()
    _DS_DN_Draugnarok draugnarok = ResolveDraugnarokQuest()
    Bool draugnarokEnabled = False
    if draugnarok
        draugnarokEnabled = draugnarok.IsDraugnarokSystemEnabled()
    endif
    Config.SyncEffectiveDisplayDifficulty(Respawn.IsRuntimeAvailable(), draugnarokEnabled)
    if Globals
        Globals.SyncDifficultyPreset()
        Globals.SyncModState()
        Globals.SyncIntegrationStatus(Game.GetPlayer())
    endif
    return True
EndFunction

Function LogSystemSnapshot()

    if !Config || !Config.IsLoggingEnabled()
        return
    endif

    ; --- SKSE / Datastore Integrity ---
    Bool skseOK = IronSoulNative.IsAvailable()
    Bool dsOK = False
    if skseOK
        dsOK = IronSoulNative.DataStoreReady()
    endif

    LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "SKSE: Available=" + skseOK \
        + " DataStore=" + dsOK)

    if Respawn
        Respawn.LogSnapshot()
    else
        LogControllerSnapshot(IronSoulConfig.LOG_ERR(), "MISSING PROPERTY: Respawn (IronSoulRespawn)")
    endif
    if Tiers
        Tiers.LogSnapshot()
    else
        LogControllerSnapshot(IronSoulConfig.LOG_ERR(), "MISSING PROPERTY: Tiers (IronSoulTiers)")
    endif
    if !Heartshards
        LogControllerSnapshot(IronSoulConfig.LOG_ERR(), "MISSING PROPERTY: Heartshards (IronSoulHeartshards)")
    endif
    if Effects
        Effects.LogSnapshot()
    else
        LogControllerSnapshot(IronSoulConfig.LOG_ERR(), "MISSING PROPERTY: Effects (IronSoulEffects)")
    endif

    ; --- Config / Runtime State ---
    Config.LogSnapshot()
    LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "Controller: ModDisabled=" + _modDisabled \
        + " UpdateQueued=" + _updateQueued \
        + " UpdateDelay=" + _updateQueuedDelay \
        + " IsQuitting=" + _isQuitting)

    String cachedGuid = ""
    if Identity
        cachedGuid = Identity.GetCachedGuid()
    endif
    LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "Identity: CachedGuid=" + cachedGuid)

    ; --- Systems ---
    Bool luckActive = False
    if Luck
        luckActive = Luck.IsRuntimeAvailable()
    endif
    Bool respawnAvailable = False
    if Respawn
        respawnAvailable = Respawn.IsRuntimeAvailable()
    endif
    LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "Systems: Luck=" + luckActive \
        + " RespawnAvailable=" + respawnAvailable)

    ; --- Luck Persistence ---
    LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "Luck: " + Luck.GetCacheSnapshot())

    ; --- Player Snapshot ---
    Actor p = Game.GetPlayer()
    if p
        Int deaths = 0
        String snapshotGuid = ""
        if Identity
            snapshotGuid = Identity.GetCachedGuid()
            if snapshotGuid == ""
                snapshotGuid = Identity.GetKnownGuidNoMint(p)
            endif
        endif
        if Death && snapshotGuid != ""
            deaths = Death.GetCurrentDeathCount(p, snapshotGuid)
        endif

        LogControllerSnapshot(IronSoulConfig.LOG_INFO(), "Player: Level=" + p.GetLevel() \
            + " Dead=" + p.IsDead() \
            + " InCombat=" + p.IsInCombat() \
            + " Deaths=" + deaths)

    endif

EndFunction

; --- Lifecycle ---
; ===============

; Runtime / Polling
Float Property StandardPollSeconds = 1.00 Auto ; Best-effort scheduler. Requested 1.0s, but under real VM load typically fires ~1.5-2.0s.
Float Property FastPollSeconds     = 0.20 Auto ; Best-effort fast mode. Requested 0.2s, but in practice usually ~0.4-0.6s.
Float Property PendingFastLoopWatchdogSeconds = 30.0 Auto ; clears stuck fast-loop jobs
Float _nextHeartbeatAt = 0.0

Bool _updateQueued = False
Float _updateQueuedDelay = 0.0
Bool _isQuitting = False

Event OnInit()

    if !IronSoulNative.IsAvailable()
        SetModDisabled(True)
        Debug.MessageBox("Iron Soul has been disabled because the required SKSE plugin (ironsoul.dll) is missing.")
        if Globals
            Globals.SyncModState()
        endif
        return
    endif

    ResetTransientState()

    if !LoadConfig()
        return
    endif
    Presentation.RegisterMusicFadeBridge()
    Presentation.RegisterMusicVolumeCacheMenus()
    Presentation.RefreshConfiguredMusicVolumeCache("init")
    IronSoulNative.StartHealthMonitor()

    LogController(IronSoulConfig.LOG_INFO(), "IronSoulController: OnInit event fired")

    StartBootstrap()

    Actor player = Game.GetPlayer()
    if !player
        LogController(IronSoulConfig.LOG_ERR(), "OnInit: Game.GetPlayer() returned None; skipping OnDying/deferred-kill setup")
    else
        player.StartDeferredKill()
        LogController(IronSoulConfig.LOG_INFO(), "OnInit: StartDeferredKill() called")
    endif

    QueueUpdate(StandardPollSeconds)

EndEvent

Function StartBootstrap()
    ; Kick off bootstrap sequence for GUID system.
    ; We retry until:
    ;  - Player reference exists, and
    ;  - EnsureGuid() can succeed (identity ready; player name available).

    Identity.StartBootstrap(10)
    _updateQueued = False

    QueueUpdate(1.0)
EndFunction

Function OnPlayerLoadGame(Bool isLoadGame)

    ; Native/plugin availability.
    if !IronSoulNative.IsAvailable()
        SetModDisabled(True)
        Debug.MessageBox("Iron Soul has been disabled because the required SKSE plugin (ironsoul.dll) is missing.")
        return
    endif

    IronSoulUI uiComponent = Presentation
    if uiComponent
        uiComponent.RegisterMusicFadeBridge()
        uiComponent.HandleMusicAfterPlayerLoad("player-load")
    endif

    ; Transient reset and load rebaseline seed.
    ResetTransientState()
    if Tiers
        Tiers.SetPendingDragonSoulsRebaseline(isLoadGame)
    endif

    Actor player = Game.GetPlayer()
    if !player
        if Config
            LogController(IronSoulConfig.LOG_ERR(), "OnPlayerLoadGame: Player is None (Alias not filled yet?)")
        endif
        return
    endif

    ; Load config / log settings first.
    if !LoadConfig()
        return
    endif

    IronSoulConfig cfg = Config
    IronSoulCleanup cleanupQ = Cleanup
    IronSoulIdentity ident = Identity
    IronSoulDeath deathQ = Death
    IronSoulJournal journalQ = Journal
    IronSoulRespawn respawnQ = Respawn
    IronSoulTiers tiersQ = Tiers
    IronSoulEffects effectsQ = Effects
    IronSoulSFX sfxQ = SFX
    IronSoulGlobals globalsQ = Globals

    uiComponent.RegisterMusicVolumeCacheMenus()

    ; Uninstall / re-enable flow.
    ; While uninstall mode is active, run/continue uninstall cleanup flow.
    if cfg.IsUninstallMode()
        cleanupQ.HandleUninstallMode(player)
        return
    endif
    ; If uninstall cleanup previously ran and uninstall mode is now OFF, re-enable runtime.
    ; Continue normal load init below so behavior is restored immediately this load.
    if _modDisabled
        cleanupQ.ReenableAfterUninstall(player)
    endif

    ; Bootstrap and identity snapshot.
    IronSoulNative.StartHealthMonitor()
    ; Re-arm bootstrap on each load so placeholder-name GUID gating remains active until identity stabilizes.
    StartBootstrap()

    ; Identity bootstrap
    String name = IronSoulNative.GetPlayerName()

    String guid = ident.GetTickGuid(player)

    LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: Player=" + name + " GUID=" + guid)

    RefreshDraugnarokRuntimeOnLoad(player)

    if guid == ""
        LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: GUID not ready")
    else
        ; Re-baseline Dragon Soul tracking on load so rollback/older-save loads never
        ; produce a fake positive delta from stale persisted last-seen state.
        Int _curSoulsLS = player.GetActorValue("DragonSouls") as Int
        tiersQ.RebaselineDragonSoulsLastSeen(player, guid, _curSoulsLS)
        tiersQ.SetPendingDragonSoulsRebaseline(False)

        deathQ.SyncCurrentDeathCountMirrors(player, guid)

        ; Determine essential state.
        respawnQ.UpdatePlayerProtectionState(player)
        if globalsQ
            globalsQ.SyncAll(player, guid)
        endif
    endif

    if guid != "" && name != ""
        ident.WriteIdentitySnapshotStatic(guid, player, name)
        ident.WriteIdentitySnapshotLastSeen(guid, player)
        ident.EnsureGuidMarker(guid)
    endif

    player.StartDeferredKill()

    ; GUID-not-ready deferral.
    ; Rare edge: identity not ready yet on this load tick.
    ; Defer GUID-dependent load work until a later update when EnsureGuid() can succeed.
    if guid == ""
        LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: GUID not ready; deferring GUID-dependent load initialization")
        uiComponent.ScheduleLoadMessage(isLoadGame)
        return
    endif

    ; Load catch-up transitions.
    Int deaths     = deathQ.GetCurrentDeathCount(player, guid)
    Int soulTier   = tiersQ.GetCurrentTier(player, guid)
    Int loadTransitionTier = tiersQ.GetLoadCatchupTransitionTier(player, guid, deaths, soulTier)

    ; Catch-up path: a transition threshold may have been reached in a prior session before the sequence completed.
    ; This load-triggered transition does NOT quit to desktop.
    if loadTransitionTier == tiersQ.TIER_DEFIANT
        LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: Defiant transition triggered on load")
        tiersQ.PromoteToDefiantTier(player, guid, soulTier)
        journalQ.LogEventForGuid(player, guid, "You refuse Sovngarde and rise again. Defiant Soul awakened. Death limit is now 20.")
        ; Load-time Defiant promotion remains in-session, so restore music after the intro closes.
        tiersQ.PlayDefiantTransitionSWF(soulTier, True)
        soulTier = tiersQ.TIER_DEFIANT

    elseif loadTransitionTier == tiersQ.TIER_CHIM
        LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: CHIM transition triggered on load")
        tiersQ.PromoteToCHIMTier(player, guid)
        tiersQ.PlayCHIMTransitionSWF(soulTier)
        soulTier = tiersQ.TIER_CHIM
    endif

    ; Presentation / effects sync.
    uiComponent.ScheduleLoadMessage(isLoadGame)
    effectsQ.SyncSoulPresentationAndStats(player, guid)

    ; Terminal and load-enforced quit paths.
    if tiersQ.IsDefiantSoulFatigueTerminal(player, guid)
        LogController(IronSoulConfig.LOG_INFO(), "OnPlayerLoadGame: Defiant Soul Fatigue terminal state reached on load")
        if !cfg.IsPermadeathEnabled() && soulTier != tiersQ.TIER_CHIM
            tiersQ.PromoteToCHIMTier(player, guid)
            ; Load-time CHIM promotion should remain in-session; only death-driven CHIM transitions quit.
            tiersQ.PlayCHIMTransitionSWF(soulTier, True)
            soulTier = tiersQ.TIER_CHIM
        else
            IronSoulNative.BeginMenuBlock("load-terminal-defiant-fatigue", True)
            uiComponent.OpenTimedMessageSWF_KeyDismiss_SFX("0_defiant_permadeath_soulfatigue", 55.0, 27.0, sfxQ.SFXPermadeath, player, False)
            FinalizeAndQuitMainMenu()
            return
        endif
    endif

    cfg.ApplyDynamicPresetAssetsForTier(soulTier)
    IronSoulNative.ApplyDynamicLevelWidget(soulTier)

    ; Effective cap (CHIM tier is effectively unbounded).
    Int maxLives = tiersQ.GetEffectiveMaxLives(player, guid)
    if globalsQ
        globalsQ.SyncAll(player, guid)
    endif
    if deaths >= maxLives
        ; Match live permadeath pacing so load-enforced exhaustion does not dismiss faster.
        IronSoulNative.BeginMenuBlock("load-terminal-permadeath", True)
        uiComponent.OpenTimedMessageSWF_KeyDismiss_SFX(IronSoulUI.ResolvePermadeathMenu(soulTier), 55.0, 27.0, sfxQ.SFXPermadeath, player, False)
        FinalizeAndQuitMainMenu()
        return
    endif

    ; Final diagnostics.
    LogSystemSnapshot()

EndFunction

Function ResetTransientState()
    ; Heartbeat / cadence timers are transient (GetCurrentRealTime can reset across reloads).
    _nextHeartbeatAt = 0.0
    _updateQueuedDelay = 0.0

    ; Runtime scheduling state
    _updateQueued = False

    ; Identity cache and bootstrap state are transient across load/init edges.
    if Identity
        Identity.ResetTransientState()
    endif

    ; Death state should not persist across reload/init edges.
    if Death
        Death.ResetTransientState()
    endif

    ; Quit latch is transient.
    _isQuitting = False
    IronSoulNative.ClearMenuBlock()

    ; Luck component cache and roll telemetry are transient.
    if Luck
        Luck.ResetTransientState()
    endif

    ; Presentation component owns load-message and key-dismiss transient state.
    if Presentation
        Presentation.ResetTransientState()
    endif

    ; Respawn component runtime is transient.
    if Respawn
        Respawn.ResetTransientState()
    endif

    ; Dragon Soul Revive component runtime is transient.
    if DragonSoulRevive
        DragonSoulRevive.ResetTransientState()
    endif

    ; Tier component runtime is transient.
    if Tiers
        Tiers.ResetTransientState()
    endif

    ; Heartshard use locks are transient.
    if Heartshards
        Heartshards.ResetTransientState()
    endif

    ; Destructive console command confirmation is transient and expires quickly.
    if Cleanup
        Cleanup.ClearDestructiveCommandConfirmation()
    endif

EndFunction


; --- Runtime Scheduling ---
; ==========================

Event OnUpdate()
    _updateQueued = False
    _updateQueuedDelay = 0.0

    if _isQuitting
        return
    endif

    if Config.IsUninstallMode() || _modDisabled
        return
    endif

    Actor player = Game.GetPlayer()

    ; Luck regen tick (menu-safe). Run early so menu time never advances.
    String tickGuid = Identity.GetCachedGuid()
    if tickGuid != ""
        Luck.TickRegen(player, tickGuid)
    endif

    ; Defer initialisation bootstrap if necessary
    if BootstrapTick()
        return
    endif

    ; Timed load-notification handler
    Presentation.HandleLoadNotification(player)

    ; Delayed first-character intro, scheduled by fresh GUID finalization.
    Presentation.HandleDelayedIronIntro(player)

    ; Low-frequency (5s) maintenance and progression integrity checks
    OnUpdateHeartbeat(player)

    ; Tier component handles delayed Soul Feat and transition SFX jobs.
    if Tiers
        Tiers.Tick(player)
    endif

    ; Respawn post-handoff monitor and delayed message jobs.
    if Respawn.Tick(player)
        return
    endif

    RescheduleIfJobsRemain()
EndEvent

Function OnUpdateHeartbeat(Actor player)

    if !player || player.IsDead() || player.IsBleedingOut()
        return
    endif

    if Utility.IsInMenuMode()
        return
    endif

    Float nowRT = Utility.GetCurrentRealTime()

    ; Run at low frequency (~5s) to avoid overhead.
    if _nextHeartbeatAt != 0.0 && nowRT < _nextHeartbeatAt
        return
    endif
    _nextHeartbeatAt = nowRT + 5.0

    ; Use per-tick GUID cache
    String guid = Identity.GetCachedGuid()
    if guid == ""
        guid = Identity.GetTickGuid(player)
    endif

    if guid == ""
        return
    endif

    DragonSoulRevive.SyncLimitState(player, guid)

    ; Refresh last-seen identity snapshot (I.L/I.D) on this low-frequency cadence.
    Identity.WriteIdentitySnapshotLastSeen(guid, player)

    Death.SyncCurrentDeathCountMirrors(player, guid)

    ; Tier progression owns Dragon Soul accounting, boss latches, and Soul Feat scheduling.
    if Tiers
        Tiers.Heartbeat(player, guid)
    endif
    ; Allow Luck notifications after first stable heartbeat.
    Luck.AllowThresholdNotifications()

    ; Datastore flush pacing (plugin no longer runs a background flush thread).
    ; Heartbeat runs ~every 5s, and this native call will flush to disk only if the
    ; datastore is dirty (i.e., a value actually changed via DataSet*IfChanged).
    IronSoulNative.DataFlushIfDirty()

EndFunction

Bool Function BootstrapTick()
    if !Identity.IsBootstrapActive()
        return False
    endif

    Actor p = Game.GetPlayer()
    if !p
        ; PAUSE retry consumption while player ref isn't available.
        LogController(IronSoulConfig.LOG_INFO(), "BootstrapTick: Player is None; waiting for player ref")
        _updateQueued = False
        QueueUpdate(1.0)
        return True
    endif

    ; Do NOT consume retries while in UI/menu mode (e.g., long RaceMenu sessions).
    if Utility.IsInMenuMode()
        LogController(IronSoulConfig.LOG_DBG(), "BootstrapTick: In menu mode; waiting")
        _updateQueued = False
        QueueUpdate(1.5)
        return True
    endif

    ; Acquire and cache a GUID when identity is ready.
    String bguid = Identity.GetTickGuid(p)
    if bguid == ""
        ; Identity not ready yet (name not available). Keep bootstrapping.
        Int bootstrapTriesLeft = Identity.ConsumeBootstrapTry()
        if bootstrapTriesLeft <= 0
            Identity.AllowPlaceholderGuidMintAfterBootstrapTimeout()
            bguid = Identity.GetTickGuid(p)
            if bguid != ""
                Identity.CompleteBootstrap()
                ApplyDraugnarokOverrideForCurrentCharacter(p)
                if Globals
                    Globals.SyncAll(p, bguid)
                endif
                SyncBootstrapDynamicAssets(p, bguid)
                LogController(IronSoulConfig.LOG_INFO(), "BootstrapTick: GUID ready after bootstrap timeout; bootstrap complete (" + bguid + ")")
                return False
            endif

            Identity.CompleteBootstrap(False)
            LogController(IronSoulConfig.LOG_ERR(), "BootstrapTick: Identity not ready after timeout; continuing normal polling")
            return False
        endif

        LogController(IronSoulConfig.LOG_INFO(), "BootstrapTick: Identity not ready; retrying (" + bootstrapTriesLeft + "s left)")
        _updateQueued = False
        QueueUpdate(1.0)
        return True
    endif

    Identity.CompleteBootstrap()
    ApplyDraugnarokOverrideForCurrentCharacter(p)
    if Globals
        Globals.SyncAll(p, bguid)
    endif
    SyncBootstrapDynamicAssets(p, bguid)
    LogController(IronSoulConfig.LOG_INFO(), "BootstrapTick: GUID ready; bootstrap complete (" + bguid + ")")

    return False
EndFunction

Function SyncBootstrapDynamicAssets(Actor player, String guid)
    if !Tiers || !player || guid == ""
        return
    endif

    Int tier = Tiers.GetCurrentTier(player, guid)
    Tiers.SyncTierDynamicAssets(tier)
    LogController(IronSoulConfig.LOG_DBG(), "SyncBootstrapDynamicAssets: tier=" + tier, True)
EndFunction

Function QueueUpdate(Float afDelay)
    ; Debounced single-update scheduler (soonest wins):
    ; - Prevents RegisterForSingleUpdate spam
    ; - Allows urgent jobs to "upgrade" a previously queued slower tick
    if afDelay < 0.0
        afDelay = 0.0
    endif
    if _updateQueued
        ; If a tick is already queued, only reschedule if the new delay is sooner.
        if _updateQueuedDelay <= 0.0 || afDelay < _updateQueuedDelay
            LogController(IronSoulConfig.LOG_DBG(), "QueueUpdate: upgrading queued delay from " + _updateQueuedDelay + " -> " + afDelay, True)
            _updateQueuedDelay = afDelay
            ; Cancel prior schedule and re-register the sooner one.
            UnregisterForUpdate()
            RegisterForSingleUpdate(afDelay)
        else
            LogController(IronSoulConfig.LOG_DBG(), "QueueUpdate: skipped; already queued sooner/equal. queued=" + _updateQueuedDelay + " req=" + afDelay, True)
        endif
        return
    endif
    _updateQueued = True
    _updateQueuedDelay = afDelay
    RegisterForSingleUpdate(afDelay)
EndFunction

Function RescheduleIfJobsRemain()
    ; Keep the update loop tight while any short-lived jobs are pending, or while the player is in bleedout (so we react quickly).
    Bool respawnFastPolling = (Respawn && Respawn.RequiresFastPolling())
    Bool tiersFastPolling = (Tiers && Tiers.RequiresFastPolling())
    Bool deathFastPolling = (Death && Death.IsDeathEventLocked())
    Bool presentationFastPolling = (Presentation && Presentation.RequiresFastPolling(PendingFastLoopWatchdogSeconds))
    if respawnFastPolling || tiersFastPolling || presentationFastPolling || deathFastPolling
        QueueUpdate(FastPollSeconds)

    else
        QueueUpdate(StandardPollSeconds)
    endif
EndFunction

Function StopRuntimeUpdates()
    _updateQueued = False
    _updateQueuedDelay = 0.0
    UnregisterForUpdate()
EndFunction


; --- Mod State ---
; =================

Bool Function IsModDisabled()
    return _modDisabled
EndFunction

Function SetModDisabled(Bool disabled)
    _modDisabled = disabled
    if Globals
        Globals.SyncModState()
    endif
EndFunction


; --- Quit Flow ---
; =================

Function FinalizeAndQuit()
    ; Centralized quit path:
    ;  - Stops periodic updates
    ;  - Waits 1 second for UI stability, then quits
    if _isQuitting
        return
    endif

    _isQuitting = True
    _updateQueued = False
    IronSoulNative.BeginMenuBlock("quit-desktop", False)
    IronSoulNative.StopHealthMonitor()
    ; Flush Luck timing cache (write-gated) before quitting.
    Luck.FlushDirtyCache()

    UnregisterForUpdate()

    Utility.Wait(1.0)
    Debug.QuitGame()
EndFunction

Function FinalizeAndQuitMainMenu()
    ; Centralized main menu quit path:
    ;  - Stops periodic updates
    ;  - Waits 1 second for UI stability, then quits
    if _isQuitting
        return
    endif

    _isQuitting = True
    _updateQueued = False
    IronSoulNative.BeginMenuBlock("quit-main-menu", True)
    IronSoulNative.StopHealthMonitor()
    ; Flush Luck timing cache (write-gated) before quitting.
    Luck.FlushDirtyCache()
    UnregisterForUpdate()

    ; Restore music before returning to the main menu so terminal no-restore flows do not leave it muted.
    if Presentation
        Presentation.RestoreMusic()
    endif

    Utility.Wait(1.0)
    Game.QuitToMainMenu()
EndFunction


; --- Draugnarok Bridge ---
; =========================

_DS_DN_Draugnarok Function ResolveDraugnarokQuest()
    ; 0x000D63 in Draugnarok.esp (_DS_Draugnarok_Main), with integrated fallback.
    Quest q = Game.GetFormFromFile(0x00000D63, "Draugnarok.esp") as Quest
    if !q
        q = Game.GetFormFromFile(0x00000D63, "Iron Soul - Dead God's Dream.esp") as Quest
    endif
    return q as _DS_DN_Draugnarok
EndFunction

Function RefreshDraugnarokRuntimeOnLoad(Actor player)
    _DS_DN_Draugnarok draugnarok = ResolveDraugnarokQuest()
    if !draugnarok
        if Globals
            Globals.SyncIntegrationStatus(player)
        endif
        return
    endif

    draugnarok.InitStuff()

    if !player
        return
    endif

    if !Persistence
        return
    endif

    Int mode = Persistence.GetDraugnarokOverrideMode(player)
    if mode != 0
        draugnarok.ApplyDraugnarokOverrideMode(mode)
    endif
    if Globals
        Globals.SyncIntegrationStatus(player)
    endif
EndFunction

Function ApplyDraugnarokOverrideForCurrentCharacter(Actor player)
    if !player
        if Globals
            Globals.SyncIntegrationStatus(player)
        endif
        return
    endif

    if !Persistence
        if Globals
            Globals.SyncIntegrationStatus(player)
        endif
        return
    endif

    Int mode = Persistence.GetDraugnarokOverrideMode(player)
    if mode == 0
        if Globals
            Globals.SyncIntegrationStatus(player)
        endif
        return
    endif

    _DS_DN_Draugnarok draugnarok = ResolveDraugnarokQuest()
    if draugnarok
        draugnarok.ApplyDraugnarokOverrideMode(mode)
    endif
    if Globals
        Globals.SyncIntegrationStatus(player)
    endif
EndFunction
